# hex in a container (compose.yaml, README "Container"). Copy to .env (git-ignored) and fill in;
# never commit .env. An empty value counts as unset for every variable left uncommented below.
# HEX_HOST, HEX_PORT, HEX_DATA_DIR, HEX_OUTBOX_DIR, MASTRA_TELEMETRY_DISABLED and DO_NOT_TRACK are
# pinned in compose.yaml; setting them here changes nothing.

# Required by compose: the host folder bind-mounted as the Outbox (/outbox in the container), where
# hex files Documents for hex-sync to move into the Archive. Must exist; never Proton Drive or the
# Archive itself. On Linux it must be writable by the container's user (uid 65532).
HEX_OUTBOX_HOST_DIR=

# Model keys, read by Mastra's model router straight from the environment (not through hex's
# Config): the provider of the Intake model (default anthropic/claude-haiku-5-5) and of the chat
# model needs its key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# The hex config file (chat, Intake, Forwarding and mailbox settings), as a path inside the
# container. compose.yaml mounts no config file yet, so leave it empty: the server then runs
# without chat, Forwarding and the mailbox watcher. The variables below take effect only with a
# config that enables them.
HEX_CONFIG=

# Forwarding by SMTP (README "Intake"), once a target is enabled. User and password are read as
# redacted secrets.
HEX_SMTP_HOST=
# Optional; left commented out for the default, 465.
# HEX_SMTP_PORT=465
# tls, starttls or plain (loopback IP address only); default tls on 465, else starttls.
# HEX_SMTP_SECURITY=tls
HEX_SMTP_USER=
HEX_SMTP_PASSWORD=

# The intake mailbox (README "Mailbox"), once the config has a mailbox section. User and password
# are read as redacted secrets.
HEX_IMAP_HOST=
# Optional; left commented out for the default, 993.
# HEX_IMAP_PORT=993
# tls, starttls or plain (loopback IP address only); default tls on 993, else starttls.
# HEX_IMAP_SECURITY=tls
HEX_IMAP_USER=
HEX_IMAP_PASSWORD=

# Slack chat channel in socket mode (README "Slack app for socket mode"), read as redacted secrets:
# the app-level token (xapp-…) and the bot token (xoxb-…).
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Signal chat channel (README "Signal"): the bot account (+ and digits, or its ACI) and the
# signal-cli daemon's HTTP URL.
SIGNAL_ACCOUNT=
SIGNAL_CLI_URL=
