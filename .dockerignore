# Only sources and manifests reach the build; never keys, databases, Intakes or local state.
# Adapted from stibbons-ai/iconograph's .dockerignore (MIT).
**/node_modules
.data
.mastra
dist
coverage
eval-results
.git
.github
.devenv*
.direnv
.env
.env.*
.envrc
.work
*.db
*.db-shm
*.db-wal
*.duckdb
*.eml
*.EML
**/fixtures
crates
docs
packages/*/test
scripts/*.test.ts
# Only its manifest is needed, for the workspace install; its sources never reach the bundle.
packages/eval-harness/*
!packages/eval-harness/package.json
