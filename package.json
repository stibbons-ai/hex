{
  "name": "hex",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/server/src/main.ts",
    "intake": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/server/src/intake.ts",
    "studio": "bun run studio:build && bun run studio:start",
    "studio:build": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bunx --minimum-release-age 259200 mastra@1.36.0 build --studio --dir packages/server/src/studio",
    "studio:start": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bunx --minimum-release-age 259200 mastra@1.36.0 start",
    "test": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun test",
    "format": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 oxfmt --write package.json tsconfig.json .oxfmtrc.json .oxlintrc.json packages scripts .github README.md",
    "format:check": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 oxfmt --check package.json tsconfig.json .oxfmtrc.json .oxlintrc.json packages scripts .github README.md",
    "lint": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 oxlint --deny-warnings .",
    "typecheck": "bun run typecheck:root && bun run typecheck:domain",
    "typecheck:root": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 tsc --noEmit",
    "typecheck:domain": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 tsc --noEmit -p packages/domain",
    "manifests": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun scripts/check-manifests.ts",
    "licenses": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun scripts/check-licenses.ts",
    "fixtures:generate": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/eval-harness/src/synthetic/main.ts",
    "eval": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/eval-harness/src/main.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run manifests && bun run licenses && bun run test"
  },
  "catalog": {
    "@chat-adapter/shared": "4.43.0",
    "@chat-adapter/slack": "4.43.0",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.80.0",
    "@mastra/duckdb": "1.16.0",
    "@mastra/libsql": "1.27.1",
    "@mastra/memory": "1.40.0",
    "@mastra/observability": "1.22.0",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/server": "1.16.1",
    "@stibbons/chat-adapter-signal": "0.1.0",
    "@types/bun": "1.4.4",
    "@types/spdx-expression-parse": "4.0.0",
    "chat": "4.43.0",
    "effect": "4.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "postal-mime": "4.2.0",
    "spdx-expression-parse": "5.0.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "spdx-expression-parse": "catalog:",
    "typescript": "catalog:"
  }
}
